<Window x:Class="TextReaderMM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:commands="clr-namespace:TextReaderMM.Commands"
        xmlns:controls="clr-namespace:TextReaderMM.Controls"
        xmlns:vm="clr-namespace:TextReaderMM.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding Title}" Height="700" Width="1100">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Command="{x:Static commands:AppCommands.OpenFile}" />
                <MenuItem Header="Open _URL..." Command="{x:Static commands:AppCommands.OpenUrl}" />
                <MenuItem Header="_Generate random text..." Command="{x:Static commands:AppCommands.GenerateRandomText}" />
                <Separator />
                <MenuItem Header="_Save as..." Command="{x:Static commands:AppCommands.SaveAs}" />
            </MenuItem>
            <MenuItem Header="_Search">
                <MenuItem Header="_Find..." Command="{x:Static commands:AppCommands.Find}" />
                <MenuItem Header="Find _next" Command="{x:Static commands:AppCommands.FindNext}" />
                <MenuItem Header="Find _previous" Command="{x:Static commands:AppCommands.FindPrevious}" />
                <Separator />
                <MenuItem Header="_Go to line..." Command="{x:Static commands:AppCommands.GoToLine}" />
                <Separator />
                <MenuItem Header="_Copy" Command="Copy" CommandTarget="{Binding ElementName=Viewer}" />
                <MenuItem Header="Select _all" Command="SelectAll" CommandTarget="{Binding ElementName=Viewer}" />
            </MenuItem>
            <MenuItem Header="Se_ttings">
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Font size" VerticalAlignment="Center" Width="60" />

                            <Slider Width="150"
                                    VerticalAlignment="Center"
                                    Minimum="8"
                                    Maximum="40"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.FontSize}" />

                            <TextBlock Text="{Binding Settings.FontSize, StringFormat={}{0:0} px}"
                                       Width="44"
                                       Margin="8,0,0,0"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>

                <MenuItem Header="_Reset font size" Command="{x:Static commands:AppCommands.ResetFontSize}" />
                <Separator />

                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Copy limit" VerticalAlignment="Center" Width="60" />

                            <Slider Width="150"
                                    VerticalAlignment="Center"
                                    Minimum="1000"
                                    Maximum="50000"
                                    TickFrequency="1000"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.MaxCopyCharacters}" />

                            <TextBlock Text="{Binding Settings.MaxCopyCharacters, StringFormat={}{0:N0} ch}"
                                       Width="70"
                                       Margin="8,0,0,0"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>

                <Separator />
                <MenuItem Header="Show _line numbers"
                          IsCheckable="True"
                          IsChecked="{Binding Settings.ShowLineNumbers}" />
            </MenuItem>
            <MenuItem Header="_Legend" Command="{x:Static commands:AppCommands.ShowShortcuts}" />
            <MenuItem Header="_Readme" Command="{x:Static commands:AppCommands.ShowReadme}" />
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusText}" />
        </StatusBar>

        <Border DockPanel.Dock="Bottom"
                Padding="6"
                Background="#F3F3F3"
                BorderBrush="#D0D0D0"
                BorderThickness="0,1,0,0"
                Visibility="{Binding Search.IsVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,6,0" />

                <TextBox x:Name="SearchBox"
                         Width="260"
                         VerticalAlignment="Center"
                         Text="{Binding Search.SearchText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnSearchBoxKeyDown" />

                <Button Content="Previous"
                        Margin="6,0,0,0"
                        Padding="10,2"
                        Command="{x:Static commands:AppCommands.FindPrevious}" />

                <Button Content="Next"
                        Margin="6,0,0,0"
                        Padding="10,2"
                        Command="{x:Static commands:AppCommands.FindNext}" />

                <CheckBox Content="Match case"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding Search.MatchCase}" />

                <CheckBox Content="Show matching lines only"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsFilterActive}" />

                <TextBlock Text="{Binding Search.ResultText}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#606060" />

                <Button Content="Close"
                        Margin="12,0,0,0"
                        Padding="10,2"
                        Click="OnCloseSearchClick" />
            </StackPanel>
        </Border>

        <controls:TextViewer x:Name="Viewer"
                             Document="{Binding DisplayDocument}"
                             LineCount="{Binding DisplayLineCount}"
                             FirstVisibleLine="{Binding Search.FirstVisibleLine, Mode=TwoWay}"
                             SearchTerm="{Binding Search.SearchText}"
                             MatchCase="{Binding Search.MatchCase}"
                             CurrentMatch="{Binding Search.CurrentMatch}"
                             FontSize="{Binding Settings.FontSize}"
                             ShowLineNumbers="{Binding Settings.ShowLineNumbers}"
                             MaxCopyCharacters="{Binding Settings.MaxCopyCharacters}" />
    </DockPanel>
</Window>
