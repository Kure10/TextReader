<Window x:Class="TextReaderMM.Views.GenerateTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate random text"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="12">
        <TextBlock Text="Number of lines:" Margin="0,0,0,6" />

        <TextBox x:Name="LineCountBox" Text="500000" />

        <TextBlock Text="Lines vary in length; every now and then a very long one appears."
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="#606060" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Generate" Padding="14,3" IsDefault="True" Click="OnOkClick" />
            <Button Content="Cancel" Padding="14,3" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
