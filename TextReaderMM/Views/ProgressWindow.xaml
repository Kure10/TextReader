<Window x:Class="TextReaderMM.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Working..."
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White">
    <StackPanel Margin="16">
        <TextBlock x:Name="StatusText" Text="Working..." Margin="0,0,0,10" />

        <ProgressBar x:Name="Progress"
                     Height="18"
                     Minimum="0"
                     Maximum="1" />

        <Button Content="Cancel"
                Padding="18,3"
                Margin="0,14,0,0"
                HorizontalAlignment="Right"
                IsCancel="True"
                Click="OnCancelClick" />
    </StackPanel>
</Window>
