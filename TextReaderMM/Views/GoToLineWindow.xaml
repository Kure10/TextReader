<Window x:Class="TextReaderMM.Views.GoToLineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Go to Line"
        Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White">
    <StackPanel Margin="12">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="[Line]:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="LineBox" Width="220" KeyDown="OnLineBoxKeyDown" />
        </StackPanel>

        <TextBlock x:Name="RangeHint"
                   Margin="0,6,0,0"
                   Foreground="#606060" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Padding="18,3" IsDefault="True" Click="OnOkClick" />
            <Button Content="Cancel" Padding="14,3" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
